# Copy to backend/.env. Never commit the real file.
ENVIRONMENT=development

# Required in production: a long random string (python -c "import secrets;print(secrets.token_urlsafe(48))").
# In development a random per-process secret is used if this is empty (sessions reset on restart).
JWT_SECRET=
COOKIE_SECURE=false            # set true when served over HTTPS

# Storage. SQLite file by default; for Postgres use postgresql+psycopg://user:pass@host:5432/supportiq
DATABASE_URL=sqlite:///./data/supportiq.db
SEED_ON_STARTUP=true
SEED_DEMO_PASSWORD=demo-password

# Language model: auto | gemini | ollama | extractive
# auto = Gemini if GEMINI_API_KEY is set, else Ollama if reachable, else extractive (no LLM).
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Retrieval: fastembed (ONNX, default) | sentence-transformers (needs PyTorch) | hashing (lexical, tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.62     # leave unset for the provider default

# Limits
MAX_UPLOAD_MB=10
AI_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10
REFUND_LEAD_APPROVAL_THRESHOLD_CENTS=30000

CORS_ORIGINS=http://localhost:3000
